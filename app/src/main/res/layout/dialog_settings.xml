<?xml version="1.0" encoding="utf-8"?>
<!-- 极简设置面板（BottomSheet 内容）：AI 字幕开关 / 更换背景 / 重置对话 / 模型只读行。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- 顶部拖拽指示条 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/frost_border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- AI 字幕开关 -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_ai_subtitle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="显示 AI 字幕"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- 切换角色 -->
    <TextView
        android:id="@+id/row_switch_avatar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="切换角色"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_avatar_swap"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground" />

    <!-- 更换背景 -->
    <TextView
        android:id="@+id/row_background"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="更换背景"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_bg_swap"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground" />

    <!-- Neko 能力中心（下载/管理离线能力） -->
    <TextView
        android:id="@+id/row_capability_center"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="Neko 能力中心"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_capability"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground" />

    <!-- 在线模型 / 语音配置 -->
    <TextView
        android:id="@+id/row_online_config"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="模型参数 / 在线语音"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_cloud"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground" />

    <!-- 重置对话 -->
    <TextView
        android:id="@+id/row_reset"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="重置对话"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:drawableStart="@drawable/ic_clear"
        android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground" />

    <!-- 模型（只读，扩展锚点） -->
    <TextView
        android:id="@+id/tv_model_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:text="模型：—"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_developer_mode"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="开发者模式"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/developer_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/row_performance_panel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:text="性能参数  ›"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_perf_overlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="显示性能信息"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_perf_logs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="开启性能记录（logcat）"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_tts_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_tts_steps"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="5"
            android:progress="5" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_live_acting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="启用表情反馈（本地/线上）"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_local_multi_turn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="本地模型多轮对话"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>
