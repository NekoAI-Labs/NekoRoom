<?xml version="1.0" encoding="utf-8"?>
<!-- 切换角色（BottomSheet 内容，磨砂主题，与设置/在线配置面板统一）。
     角色行在代码里动态填进 ll_avatar_list（两个内置 + 扫描到的自定义模型）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- 顶部拖拽指示条 -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/frost_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="切换角色"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <!-- 角色列表（代码动态填充） -->
        <LinearLayout
            android:id="@+id/ll_avatar_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@color/frost_border" />

        <!-- 导入模型压缩包（ZIP / 7Z / RAR） -->
        <TextView
            android:id="@+id/row_import_model"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:text="导入模型（ZIP / 7Z / RAR）"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:drawableStart="@drawable/ic_import"
            android:drawablePadding="12dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="仅支持 Cubism 3/4/5 模型（含 .model3.json + .moc3 + 贴图）。老的 Cubism 2.x（.moc）不支持。"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
