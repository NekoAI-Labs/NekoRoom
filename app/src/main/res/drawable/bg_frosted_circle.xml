<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃态齿轮设置圆钮（v3.1 伪磨砂）：半透明 scrim + 顶部高光 + 亮白玻璃边 + ripple 提亮。
     oval 不铺噪点（tile bitmap 无法裁成圆，会漏方角），圆钮小、靠高光+亮边已够玻璃感。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- 1. 半透明 scrim -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/glass_fill" />
                </shape>
            </item>
            <!-- 2. 顶→底高光渐变：玻璃反光 -->
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#00FFFFFF"
                        android:endColor="@color/glass_sheen_top" />
                </shape>
            </item>
            <!-- 3. 亮白玻璃边高光 -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="@color/glass_edge" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
