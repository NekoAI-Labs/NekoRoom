<?xml version="1.0" encoding="utf-8"?>
<!-- 共享字幕小长条：半透明深底药丸，文字嵌其中；随 TextView alpha 一起淡入淡出，只在说话时出现。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/bg_dim_alpha" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/frost_border" />
</shape>
