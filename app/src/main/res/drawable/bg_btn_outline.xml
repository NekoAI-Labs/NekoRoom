<?xml version="1.0" encoding="utf-8"?>
<!-- 测试连通性按钮：粉色描边**始终不变**，只在按下 / 禁用时把内芯变淡（露出更多底色），
     视觉上像"按空了"但轮廓仍完整——按钮不会消失。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0DFFF5FA" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/accent_pink" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0DFFF5FA" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/accent_pink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/frost_surface" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/accent_pink" />
        </shape>
    </item>
</selector>
